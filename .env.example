# Database connection (PostgreSQL + pgvector)
# Automatically falls back to local SQLite + vector store if PostgreSQL is not running
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/swe_agent

# LLM Configuration (auto | gemini | openai | mock)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional GitHub Personal Access Token for opening live GitHub Pull Requests
GITHUB_TOKEN=

# Self-healing test loop maximum iterations
MAX_TEST_ITERATIONS=3

